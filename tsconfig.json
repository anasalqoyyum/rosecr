{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "electron"]
  },
  "include": ["src/main/**/*.js", "src/shared/**/*.js", "test/**/*.js"]
}
