  "narrative": {
    "northStar": "The game stays in focus.",
    "overview": "Rosecr's proposed interface keeps the controller compact and settings shallow, leaving the game as the main view. Light utility surfaces use a muted rose action color. Translation uses a separate dark plate with bright text so it can sit over varied game imagery. Noto Sans and Noto Sans JP cover the two planned languages.\n\nThis direction is captured in [the local design foundation](docs/design-foundation.html) and the [Paper boards](https://app.paper.design/file/01M5SK8JB1SSBWD365703FBZP9). It is a proposed v1 system, not a description of every shipped screen. M0 has an Electron shell and capture marker; it does not include OCR or translation.",
    "keyCharacteristics": [
      "Compact controls around a game-first experience.",
      "Distinct Japanese and Latin font stacks.",
      "High-contrast translation plates separated from light settings surfaces.",
      "Written state labels for idle, waiting, updating, and error."
    ],
    "rules": [
      {"name": "The State Label Rule", "body": "Pair status color with a word such as \"Starting\", \"Capturing\", \"Waiting\", or \"Updating\". Color alone does not explain what Rosecr is doing.", "section": "colors"},
      {"name": "The Complete Result Rule", "body": "Never show a partial translation. Commit the finished text as one update.", "section": "components"}
    ],
    "dos": [
      "Do keep controls compact and leave the game as the main view.",
      "Do pair status colors with explicit text labels.",
      "Do keep the source visible until the first complete translation is ready.",
      "Do keep the last valid translation readable while an update is pending.",
      "Do preserve all translated text and use a callout only after readable in-place layouts fail.",
      "Do reflow settings for resized desktop windows."
    ],
    "donts": [
      "Don't treat the design mockup or its synthetic examples as shipped OCR or translation behavior.",
      "Don't show streamed or partial translation text.",
      "Don't make passive translation plates interactive.",
      "Don't add a provider marketplace to the v1 settings. Codex is the only planned provider.",
      "Don't turn settings into a dashboard or a nested-card layout."
    ]
  }
